{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUMCM FIGURE_MANIFEST",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "figure_id",
    "question_id",
    "purpose",
    "main_message",
    "source_artifacts",
    "plot_type",
    "encodings",
    "outputs",
    "audit",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "figure_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "main_message": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "plot_type": {
      "type": "string",
      "minLength": 1
    },
    "encodings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "field",
          "unit"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "scale": {
            "type": "string"
          }
        }
      }
    },
    "caption": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "format",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "status"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unverified"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
